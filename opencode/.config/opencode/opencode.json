{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/gpt-5.6-luna",
  "plugin": [
    "@mohak34/opencode-notifier@latest"
  ],
  "autoupdate": false,  

  "provider": {
     "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "gemma4:e4b": {
          "_launch": true,
          "name": "gemma4:e4b"
        },
        "qwen3:8b": {
          "tools": true
        }
      }
    }
  },
  "mcp": {
    "glab": {
      "type": "local",
      "command": ["glab", "mcp", "serve"],
      "enabled": true
    },
    "kubectl-mcp": {
      "type": "local",
      "command": ["/home/wmiles/.kube-mcp-venv/bin/kubectl-mcp"],
      "enabled": true
    },
    "azure": {
      "type": "local",
      "command": ["npx", "-y", "@azure/mcp@latest", "server", "start"],
      "enabled": true
    }
  },


  "permission": {
    "bash": {
      "*": "allow",
      "touch *": "ask",
      "mkdir *": "ask",
      "rm *": "ask",
      "rm -rf /tmp/*": "allow",
      "rm -f /tmp/*": "allow",
      "rm -f /kbr/*": "allow",
      "cp *": "ask",
      "mv *": "ask",
      "dd *": "ask",
      "sudo *": "ask",
      "chmod *": "ask",
      "chown *": "ask",
      "curl *": "ask",
      "wget *": "ask",
      "npm install *": "ask",
      "pip install *": "ask",
      "reboot": "ask",
      "shutdown": "ask",
      "kill *": "ask",
      "killall *": "ask",
      "docker run *": "ask",
      "mkfs *": "ask",
      "fdisk *": "ask",
      "parted *": "ask",
      "format *": "ask",
      "git push": "ask",
      "git reset --hard *": "ask",
      "git clean *": "ask",
      "git branch -d *": "ask",
      "git branch -D *": "ask",
      "git rebase *": "ask",
      "git push*": "ask",
      "git pull*": "ask",
      "git merge*": "ask",
      "git rebase*": "ask",
      "git reset*": "ask",
      "git checkout*": "ask",
      "npm run publish": "ask",
      "brew install *": "ask",
      "brew upgrade *": "ask",
      "ssh *": "ask",
      "scp *": "ask",
      "rsync *": "ask",
      "kubectl edit *": "ask",
      "kubectl apply *": "ask",
      "kubectl delete *": "ask",
      "glab api *": "ask",
      "firefly deploy *": "ask",
      "f deploy *": "ask",
      "systemctl *": "ask",
      "az *": "ask"
    },
    "doom_loop": "ask",
    "external_directory": "allow"
  }
}
